-- ==========================================
-- RELOAD CLEANUP
-- ==========================================

local controller = {}
local stopped = false

function controller.Stop()
    if stopped then
        return
    end

    stopped = true

    -- Disable both toggles immediately
    active = false
    autoSteps = false
    autoRebirth = false

    -- Invalidate existing automatic loops
    stepsGeneration += 1
    rebirthGeneration += 1

    -- Reset cooldown tracking
    lastAutoExecution = -math.huge
    lastManualExecution = -math.huge

    -- Stop dragging
    dragging = false

    -- Update the status before removing the GUI
    updateStatus()

    -- Destroy the previous GUI
    if gui.Parent then
        gui:Destroy()
    end
end

_G.Only1Controller = controller

gui.Destroying:Connect(function()
    active = false
    autoSteps = false
    autoRebirth = false

    stepsGeneration += 1
    rebirthGeneration += 1

    dragging = false
end)

-- ==========================================
-- INITIALISE
-- ==========================================

autoSteps = false
autoRebirth = false

updateStatus()
